# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and must NEVER be committed or exposed publicly.

COMPOSE_PROJECT_NAME=freeboardgames

BUILD_DIR_COMMON="common"
BUILD_IMAGE_COMMON="fbg-common:latest"

BUILD_DIR_WEB="web"
BUILD_IMAGE_WEB="freeboardgames/web:latest"

BUILD_DIR_FBG="fbg-server"
BUILD_IMAGE_FBG="freeboardgames/fbg-server:latest"

BUILD_DIR_BACKUPER="misc/backuper"
BUILD_IMAGE_BACKUPER="freeboardgames/fbg-backuper:latest"

# --- secrets (leave blank / replace with your own) ---

# Fine-grained GitHub personal access token used by scripts/gh.py and CI helpers.
GITHUB_TOKEN=

# JWT signing secret for fbg-server auth.
JWT_SECRET=

# SQLite database file used by fbg-server in development.
DATABASE_PATH=fbg-server/data/fbg.sqlite

# --- GitHub OAuth (4th objective) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/auth/github/callback
