{
  "name": "fbg-runner",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "codegen": "node cli/codegen/cli.js",
    "test": "node cli/test/test.js",
    "lint": "node cli/lint/lint.js",
    "fix": "node cli/fix/fix.js",
    "dev": "node cli/dev/cli.js",
    "ci": "bun run test && ./docker-build.sh -db && ./misc/test_minikube",
    "build": "cd web/ && bun run build && bun run build:server",
    "storybook": "cd web/ && bun run storybook",
    "dev:internal": "run-p web:dev backend:dev",
    "backend:dev": "cd fbg-server/ && bun run start",
    "ci:web": "cd web/ && bun run ci",
    "install:backend": "cd fbg-server/ && bun install",
    "install:web": "cd web/ && bun install",
    "install:e2e": "cd misc/e2e && bun install",
    "postinstall": "run-s install:*",
    "test:backend": "cd fbg-server/ && bun run test",
    "test:web": "cd web/ && bun run test",
    "web:dev": "cd web/ && bun run dev:internal"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "chalk": "^5.3.0",
    "shelljs": "^0.8.5"
  }
}
